// Brass/F Horn mute: generated from the VSCO 2 CE (CC0) file names; C-1 convention: their A#0 is MIDI 34
<control> default_path=Brass/F Horn/mute/
<global> ampeg_release=0.4
<region> sample=MOHorn_mute_A#1_v1_1.wav lokey=0 hikey=48 pitch_keycenter=46 lovel=1 hivel=63
<region> sample=MOHorn_mute_A#1_v2_1.wav lokey=0 hikey=48 pitch_keycenter=46 lovel=64 hivel=127
<region> sample=MOHorn_mute_D#2_v1_1.wav lokey=49 hikey=52 pitch_keycenter=51 lovel=1 hivel=63
<region> sample=MOHorn_mute_D#2_v2_1.wav lokey=49 hikey=52 pitch_keycenter=51 lovel=64 hivel=127
<region> sample=MOHorn_mute_F2_v1_1.wav lokey=53 hikey=56 pitch_keycenter=53 lovel=1 hivel=63
<region> sample=MOHorn_mute_F2_v2_1.wav lokey=53 hikey=56 pitch_keycenter=53 lovel=64 hivel=127
<region> sample=MOHorn_mute_C3_v1_1.wav lokey=57 hikey=61 pitch_keycenter=60 lovel=1 hivel=42
<region> sample=MOHorn_mute_C3_v2_1.wav lokey=57 hikey=61 pitch_keycenter=60 lovel=43 hivel=84
<region> sample=MOHorn_mute_C3_v3_1.wav lokey=57 hikey=61 pitch_keycenter=60 lovel=85 hivel=127
<region> sample=MOHorn_mute_D#3_v1_1.wav lokey=62 hikey=65 pitch_keycenter=63 lovel=1 hivel=63
<region> sample=MOHorn_mute_D#3_v2_1.wav lokey=62 hikey=65 pitch_keycenter=63 lovel=64 hivel=127
<region> sample=MOHorn_mute_G#3_v1_1.wav lokey=66 hikey=69 pitch_keycenter=68 lovel=1 hivel=63
<region> sample=MOHorn_mute_G#3_v2_1.wav lokey=66 hikey=69 pitch_keycenter=68 lovel=64 hivel=127
<region> sample=MOHorn_mute_A#3_v1_1.wav lokey=70 hikey=72 pitch_keycenter=70 lovel=1 hivel=63
<region> sample=MOHorn_mute_A#3_v2_1.wav lokey=70 hikey=72 pitch_keycenter=70 lovel=64 hivel=127
