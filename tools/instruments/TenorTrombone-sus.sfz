// Brass/Tenor Trombone sus: generated from the VSCO 2 CE (CC0) file names; C-1 convention: their A#0 is MIDI 34
<control> default_path=Brass/Tenor Trombone/sus/
<global> ampeg_release=0.4
<region> sample=tenortbn_sus_A#0_v1_1.wav lokey=0 hikey=35 pitch_keycenter=34 lovel=1 hivel=63
