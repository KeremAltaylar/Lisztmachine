// Brass/F Horn sus: generated from the VSCO 2 CE (CC0) file names; C-1 convention: their A#0 is MIDI 34
<control> default_path=Brass/F Horn/sus/
<global> ampeg_release=0.4
<region> sample=MOHorn_sus_A0_v1_1.wav lokey=0 hikey=34 pitch_keycenter=33 lovel=1 hivel=127
