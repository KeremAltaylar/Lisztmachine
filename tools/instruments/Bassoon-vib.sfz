// Woodwinds/Bassoon vib: generated from the VSCO 2 CE (CC0) file names; C-1 convention: their A#0 is MIDI 34
<control> default_path=Woodwinds/Bassoon/vib/
<global> ampeg_release=0.4
<region> sample=PSBassoon_G1_v1_1.wav lokey=0 hikey=44 pitch_keycenter=43 lovel=1 hivel=63
<region> sample=PSBassoon_G1_v2_1.wav lokey=0 hikey=44 pitch_keycenter=43 lovel=64 hivel=127
<region> sample=PSBassoon_A1_v1_1.wav lokey=45 hikey=46 pitch_keycenter=45 lovel=1 hivel=63
<region> sample=PSBassoon_A1_v2_1.wav lokey=45 hikey=46 pitch_keycenter=45 lovel=64 hivel=127
<region> sample=PSBassoon_C2_v1_1.wav lokey=47 hikey=51 pitch_keycenter=48 lovel=1 hivel=63
<region> sample=PSBassoon_C2_v2_1.wav lokey=47 hikey=51 pitch_keycenter=48 lovel=64 hivel=127
<region> sample=PSBassoon_G2_v1_1.wav lokey=52 hikey=56 pitch_keycenter=55 lovel=1 hivel=63
<region> sample=PSBassoon_G2_v2_1.wav lokey=52 hikey=56 pitch_keycenter=55 lovel=64 hivel=127
<region> sample=PSBassoon_A2_v2_1.wav lokey=57 hikey=58 pitch_keycenter=57 lovel=1 hivel=127
<region> sample=PSBassoon_C3_v1_1.wav lokey=59 hikey=62 pitch_keycenter=60 lovel=1 hivel=63
<region> sample=PSBassoon_C3_v2_1.wav lokey=59 hikey=62 pitch_keycenter=60 lovel=64 hivel=127 seq_length=2 seq_position=1
<region> sample=PSBassoon_C3_v2_2.wav lokey=59 hikey=62 pitch_keycenter=60 lovel=64 hivel=127 seq_length=2 seq_position=2
<region> sample=PSBassoon_E3_v1_1.wav lokey=63 hikey=65 pitch_keycenter=64 lovel=1 hivel=63
<region> sample=PSBassoon_E3_v2_1.wav lokey=63 hikey=65 pitch_keycenter=64 lovel=64 hivel=127 seq_length=2 seq_position=1
<region> sample=PSBassoon_E3_v2_2.wav lokey=63 hikey=65 pitch_keycenter=64 lovel=64 hivel=127 seq_length=2 seq_position=2
